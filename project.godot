; Engine configuration file.
; NACHTSIEGEL landscape ritual arena

config_version=5

[application]
config/name="ORAFOLD"
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/NACHTSIEGEL"
config/icon="res://assets/icon.svg"
run/main_scene="res://scenes/alpha_shell.tscn"
run/main_scene.archive_qa="res://scenes/front_end.tscn"
run/main_scene.native_smoke_qa="res://scenes/production_native_smoke.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="ORAFOLD - Strategisches Kartenspiel in fünf Kampfpfaden"

[autoload]
GameAudio="*res://scripts/game_audio.gd"
ArtDelivery="*res://scripts/production/art_delivery.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="disabled"
window/handheld/orientation=6

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.035, 0.035, 0.055, 1)

[input_devices]
pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true
