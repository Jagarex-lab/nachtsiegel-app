extends SceneTree
## Storage adversarial tests use real files. The immutable v1 replay was exported
## by Session at fde508e85a2866e24653ef25d920a59832d2d653, not generated by v2.
# Godot4.6.3: anchor the shared catalog hierarchy through Session before Store.
# Duplicate direct Base/Subclass preloads in this entry script retain two Script
# resources at engine exit even when no test is run; the real classes stay intact.
const Session = preload("res://scripts/alpha/session.gd")
const Store = preload("res://scripts/production/profile_store.gd")
const WebMirrorFixture = preload("res://tests/fixtures/production/web_mirror_store.gd")
const ROOT := "res://work/production-storage/cases"
var assertions := 0
var failures := 0
var production_games := 0
var production_deferred := false
var old_catalog = _archived_type().new()

class InjectedTerminalFailure extends "res://scripts/alpha/model.gd":
	## Error-injection fixture only. This is not a card or supported game command.
	func execute(_command: String, _args: Array) -> Dictionary:
		state.error="Deliberately injected post-acceptance technical failure"
		_trace("test_injected_technical_failure","system",{"test_only":true})
		return {"ok":false,"accepted":true,"reason":"effect_resolution_error"}

func _archived_type():
	# Runtime lookup avoids registering the same base/subclass Script types a
	# second time in this test entry; these are the real Session catalog classes.
	return load("res://scripts/alpha/catalog.gd")

func _production_type():
	return load("res://scripts/production/catalog.gd")

func _initialize() -> void: call_deferred("run")

func check(ok: bool, label: String) -> void:
	assertions += 1
	if not ok:
		failures += 1
		printerr("FAIL: ",label)

func same(a: Variant, b: Variant, label: String) -> void:
	check(JSON.stringify(a,"",true)==JSON.stringify(b,"",true),label)

func write_raw(path: String, text: String) -> void:
	var f=FileAccess.open(path,FileAccess.WRITE)
	check(f!=null,"fixture write opens "+path.get_file())
	if f!=null:
		f.store_string(text);f.close()

func write_json(path: String, data: Variant) -> void: write_raw(path,JSON.stringify(data))

func read_json(path: String) -> Variant:
	if not FileAccess.file_exists(path): return null
	return JSON.parse_string(FileAccess.get_file_as_string(path))

func remove_tree(path: String) -> void:
	var absolute=ProjectSettings.globalize_path(path)
	if DirAccess.dir_exists_absolute(absolute):
		var directory=DirAccess.open(absolute)
		for item in directory.get_files(): DirAccess.remove_absolute(absolute.path_join(item))
		for item in directory.get_directories(): remove_tree(absolute.path_join(item))
		DirAccess.remove_absolute(absolute)
	elif FileAccess.file_exists(absolute): DirAccess.remove_absolute(absolute)

func case_store(name: String):
	var directory=ROOT.path_join(name)
	remove_tree(directory)
	check(DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(directory))==OK,"case directory "+name)
	var store=Store.new(directory.path_join("profile.json"))
	# This is a real catalog with real deck validation, no fake acceptance helper.
	store.catalog=old_catalog
	return store

func v1_profile() -> Dictionary:
	return {"version":1,"decks":{"alpha:houses":{"mode":"alpha","cards":old_catalog.deck("houses")}},
		"wins":17,"reduced_motion":true,"last_seed":12345,"faction":"houses","difficulty":5}

func valid_profile() -> Dictionary:
	var p=Store.defaults()
	p.decks={"alpha:houses":{"mode":"alpha","cards":old_catalog.deck("houses"),"catalog_profile":"production-550-v1"}}
	p.wins=9
	return p

func migration_store(name: String):
	var holder=case_store(name)
	var directory=holder.path.get_base_dir()
	var store=Store.new(directory.path_join("orafold_profile_v2.json"),directory.path_join("orafold_alpha_profile_v1.json"))
	store.catalog=_production_type().new()
	return store

func web_fixture(name: String):
	var holder=case_store(name)
	var store=WebMirrorFixture.new(holder.path)
	store.catalog=old_catalog
	return store

func test_authoritative_web_backend() -> void:
	var store=web_fixture("web-authoritative")
	var primary=valid_profile();primary.wins=9
	var backup=valid_profile();backup.wins=8
	var stale=valid_profile();stale.wins=2
	store.memory={"primary":JSON.stringify(primary),"backup":JSON.stringify(backup)}
	write_json(store.path,stale)
	var loaded: Dictionary=store.load_profile()
	check(loaded.profile.wins==9,"native Web-backend fixture prefers valid independent mirror over stale IDBFS file")
	check(DirAccess.remove_absolute(ProjectSettings.globalize_path(store.path))==OK,"simulate stale IDBFS deletion of secondary file")
	check(store.load_profile().profile.wins==9,"independent mirror survives removal of entire secondary profile")
	write_json(store.path,stale)
	store.memory.primary="not valid JSON"
	loaded=store.load_profile()
	check(loaded.recovered and loaded.profile.wins==8,"valid independent mirror backup outranks stale secondary file")
	store.memory.primary=JSON.stringify(primary)
	loaded=store.load_profile()
	var original_file=FileAccess.get_file_as_bytes(store.path)
	var original_memory=store.memory.duplicate(true)
	store.reject_writes=true
	var changed=loaded.profile.duplicate(true);changed.wins=10
	check(not store.save_profile(changed),"injected mirror write failure is returned")
	check(FileAccess.get_file_as_bytes(store.path)==original_file,"mirror failure occurs before any secondary filesystem write")
	same(store.memory,original_memory,"injected mirror failure keeps independent primary and backup")
	# Session-level settings/deck rollback uses the real Session save methods.
	var session=Session.new();session.store=store;session.profile=loaded.profile.duplicate(true)
	session._saved_profile=session.profile.duplicate(true)
	session.profile.difficulty=1
	check(not session.save_profile(),"settings save reports injected mirror failure")
	same(session.profile,loaded.profile,"failed settings save restores previous in-memory profile")
	check(not session.save_deck("alpha:morph",old_catalog.deck("morph"),"alpha").ok,"new deck save reports injected mirror failure")
	check(not session.profile.decks.has("alpha:morph"),"failed deck save creates no in-memory custom slot")
	store.reject_writes=false
	check(DirAccess.make_dir_absolute(ProjectSettings.globalize_path(store.path+".tmp"))==OK,"block only secondary filesystem destination")
	check(store.save_profile(changed),"durable mirror commit remains successful if secondary filesystem fails")
	check(not store.last_warning.is_empty(),"secondary filesystem failure is exposed as a warning")
	check(FileAccess.get_file_as_bytes(store.path)==original_file,"failed secondary write does not alter stale secondary bytes")
	check(store.load_profile().profile.wins==10,"fresh load reads committed primary despite failed secondary persistence")
	var future=valid_profile();future.version=99
	store.memory.primary=JSON.stringify(future)
	var future_bytes=store.memory.primary
	loaded=store.load_profile()
	check(store.write_blocked and not loaded.issues.is_empty(),"unknown future mirror is read-only and never downgraded from secondary file")
	check(not store.save_profile(primary) and store.memory.primary==future_bytes,"unknown future independent primary remains unchanged")
	store=web_fixture("web-unavailable")
	write_json(store.path,primary)
	store.reject_reads=true
	loaded=store.load_profile()
	check(loaded.profile.wins==9 and not loaded.issues.is_empty(),"unavailable mirror allows read-only filesystem fallback with notice")
	original_file=FileAccess.get_file_as_bytes(store.path)
	check(not store.save_profile(loaded.profile) and FileAccess.get_file_as_bytes(store.path)==original_file,"unavailable authoritative mirror cannot claim successful filesystem-only save")
	store=web_fixture("web-first-import")
	store.migration_path=store.path.get_base_dir().path_join("old.json")
	write_json(store.migration_path,v1_profile())
	var old_bytes=FileAccess.get_file_as_bytes(store.migration_path)
	loaded=store.load_profile()
	check(loaded.get("imported",false),"empty independent namespace imports old filesystem profile")
	check(store.save_profile(loaded.profile),"first import commits independent primary before secondary file")
	check(store.memory.backup.to_utf8_buffer()==old_bytes,"first independent backup preserves exact old import bytes")
	check(FileAccess.get_file_as_bytes(store.path+".bak")==old_bytes and FileAccess.get_file_as_bytes(store.migration_path)==old_bytes,"first secondary backup is exact and old source stays unchanged")

func test_storage_namespace_isolation() -> void:
	var default_store=Store.new()
	check(default_store.path=="user://orafold_profile_v2.json" and Session.PROFILE==default_store.path,"normal Session and Store use isolated production v2 file")
	check(default_store.migration_path=="user://orafold_alpha_profile_v1.json","only normal current store discovers old profile automatically")
	check(Store.new("res://work/custom-profile.json").migration_path.is_empty(),"custom store path never implicitly reads another old profile")
	var store=migration_store("namespace-isolation")
	var old=v1_profile()
	var old_backup=v1_profile();old_backup.wins=11
	write_json(store.migration_path,old)
	write_json(store.migration_path+".bak",old_backup)
	var source_bytes=FileAccess.get_file_as_bytes(store.migration_path)
	var source_backup_bytes=FileAccess.get_file_as_bytes(store.migration_path+".bak")
	var imported: Dictionary=store.load_profile()
	check(imported.get("imported",false) and imported.get("migrated",false),"v1 old namespace is explicitly imported and migrated")
	check(imported.get("migration_source")==store.migration_path,"import source path is identified")
	check(not FileAccess.file_exists(store.path) and not FileAccess.file_exists(store.path+".bak"),"import is read-only until explicit save")
	check(FileAccess.get_file_as_bytes(store.migration_path)==source_bytes and FileAccess.get_file_as_bytes(store.migration_path+".bak")==source_backup_bytes,"import leaves both old source files byte-identical")
	# Simulate an old cached runtime writing after import but before first save.
	var stale=v1_profile();stale.wins=91;stale.difficulty=1;stale.reduced_motion=false
	write_json(store.migration_path,stale)
	var stale_bytes=FileAccess.get_file_as_bytes(store.migration_path)
	check(store.save_profile(imported.profile),"first explicit import save writes isolated v2")
	check(read_json(store.path).version==2 and read_json(store.path).wins==17,"new current file contains imported snapshot, not later old-tab write")
	check(FileAccess.get_file_as_bytes(store.path+".bak")==source_bytes,"first current backup preserves the exact successfully parsed import bytes")
	check(FileAccess.get_file_as_bytes(store.migration_path)==stale_bytes and FileAccess.get_file_as_bytes(store.migration_path+".bak")==source_backup_bytes,"first v2 save never writes old main or old backup")
	var production_deck: Array=store.catalog.deck("houses")
	var has_new_id := false
	for id in production_deck:
		if str(id).begins_with("of-"):has_new_id=true
	check(has_new_id and store.catalog.validate(production_deck).ok,"isolation fixture uses a real valid production deck containing new card IDs")
	var current=imported.profile.duplicate(true)
	current.decks["alpha:houses"]={"mode":"alpha","cards":production_deck,"catalog_profile":Session.PRODUCTION_PROFILE}
	current.wins=42;current.difficulty=2;current.reduced_motion=true
	check(store.save_profile(current),"save actual new-card production deck in isolated namespace")
	var current_bytes=FileAccess.get_file_as_bytes(store.path)
	stale.wins=999;stale.difficulty=5;stale.decks={}
	write_json(store.migration_path,stale)
	var reloaded=Store.new(store.path,store.migration_path);reloaded.catalog=store.catalog
	var protected: Dictionary=reloaded.load_profile()
	check(not protected.get("imported",false),"existing v2 never reimports an old cached tab's file")
	same(protected.profile,current,"old cached writer cannot erase new-card deck or settings after v2 save")
	check(FileAccess.get_file_as_bytes(store.path)==current_bytes,"old writer touches no v2 bytes")
	# A current-namespace backup must outrank an old writer even if main is lost.
	check(reloaded.save_profile(current),"create current-namespace last-good backup")
	check(DirAccess.remove_absolute(ProjectSettings.globalize_path(store.path))==OK,"controlled removal of current main for recovery test")
	var missing=Store.new(store.path,store.migration_path);missing.catalog=store.catalog
	var restored: Dictionary=missing.load_profile()
	check(restored.recovered and not restored.get("imported",false),"missing current main uses current backup rather than old source")
	same(restored.profile,current,"current backup preserves new production card IDs despite newer stale old file")

func test_import_backup_and_versions() -> void:
	var store=migration_store("old-prerelease-v2")
	var old=Store.defaults()
	old.decks={"alpha:houses":{"mode":"alpha","cards":store.catalog.deck("houses"),"catalog_profile":Session.PRODUCTION_PROFILE}}
	old.wins=23
	write_json(store.migration_path,old)
	var original=FileAccess.get_file_as_bytes(store.migration_path)
	var imported: Dictionary=store.load_profile()
	check(imported.get("imported",false) and imported.profile.wins==23,"supported prerelease v2 in old filename is imported")
	same(imported.profile.decks,old.decks,"prerelease v2 production IDs survive import")
	check(store.save_profile(imported.profile),"prerelease v2 import explicit save")
	check(FileAccess.get_file_as_bytes(store.path+".bak")==original and FileAccess.get_file_as_bytes(store.migration_path)==original,"prerelease import has exact backup and unchanged old source")
	store=migration_store("old-backup-recovery")
	write_raw(store.migration_path,"corrupt old main")
	write_json(store.migration_path+".bak",v1_profile())
	var backup=FileAccess.get_file_as_bytes(store.migration_path+".bak")
	imported=store.load_profile()
	check(imported.recovered and imported.get("migration_source")==store.migration_path+".bak","valid old backup is imported after corrupt old main")
	check(store.save_profile(imported.profile),"old backup migration saves current file")
	check(FileAccess.get_file_as_bytes(store.path+".bak")==backup,"current backup records exact valid old backup, not corrupt old main")
	check(FileAccess.get_file_as_string(store.migration_path)=="corrupt old main" and FileAccess.get_file_as_bytes(store.migration_path+".bak")==backup,"old recovery leaves both historical sources unchanged")
	store=migration_store("bad-old-backups")
	write_raw(store.migration_path,"broken main")
	write_json(store.migration_path+".bak",["wrong root"])
	var bad_backup=FileAccess.get_file_as_bytes(store.migration_path+".bak")
	var invalid: Dictionary=store.load_profile()
	check(not invalid.recovered and not invalid.get("imported",false) and not invalid.issues.is_empty(),"invalid old main/backup do not claim successful import")
	check(store.save_profile(invalid.profile),"explicit defaults save does not depend on invalid old bytes")
	check(not FileAccess.file_exists(store.path+".bak"),"invalid old source is never labelled a valid import backup")
	check(FileAccess.get_file_as_string(store.migration_path)=="broken main" and FileAccess.get_file_as_bytes(store.migration_path+".bak")==bad_backup,"invalid old bytes remain recoverable untouched")
	for from_current in [false,true]:
		store=migration_store("foreign-namespace-"+str(from_current))
		var target=store.path if from_current else store.migration_path
		var future=Store.defaults();future.version=99
		write_json(target,future)
		var bytes=FileAccess.get_file_as_bytes(target)
		var blocked: Dictionary=store.load_profile()
		check(not blocked.issues.is_empty() and store.write_blocked,"future version blocks writing in selected namespace "+str(from_current))
		check(not store.save_profile(Store.defaults()),"defaults cannot overwrite unknown version "+str(from_current))
		check(FileAccess.get_file_as_bytes(target)==bytes,"future source remains byte-identical "+str(from_current))
	store=migration_store("unknown-current-profile-type")
	var malformed=Store.defaults();malformed.catalog_profile=17
	write_json(store.path,malformed)
	write_json(store.migration_path,v1_profile())
	var current_bytes=FileAccess.get_file_as_bytes(store.path)
	invalid=store.load_profile()
	check(store.write_blocked and not invalid.get("imported",false),"unknown current catalog type never falls back to old namespace")
	check(not store.save_profile(Store.defaults()) and FileAccess.get_file_as_bytes(store.path)==current_bytes,"unknown current catalog type cannot be overwritten")
	store=migration_store("import-save-failure")
	write_json(store.migration_path,v1_profile())
	var preserved=FileAccess.get_file_as_bytes(store.migration_path)
	imported=store.load_profile()
	check(DirAccess.make_dir_absolute(ProjectSettings.globalize_path(store.path+".bak"))==OK,"block new import backup destination with real directory")
	check(not store.save_profile(imported.profile),"failed first import backup prevents current save")
	check(not FileAccess.file_exists(store.path) and FileAccess.get_file_as_bytes(store.migration_path)==preserved,"failed import save leaves old source and absent current file intact")

func test_v1_migration() -> void:
	var store=case_store("v1-migration")
	var original=v1_profile()
	write_json(store.path,original)
	var bytes=FileAccess.get_file_as_bytes(store.path)
	var loaded: Dictionary=store.load_profile()
	check(loaded.get("migrated",false),"v1 migration is explicitly reported")
	check(loaded.profile.version==2,"v1 migrates to profile v2")
	check(not loaded.recovered,"valid v1 does not claim backup recovery")
	check(loaded.issues.is_empty(),"valid stable-ID v1 has no repair issues")
	if not loaded.profile.decks.has("alpha:houses"): return
	same(loaded.profile.decks["alpha:houses"].cards,original.decks["alpha:houses"].cards,"stable IDs and exact deck order preserved")
	check(loaded.profile.wins==17 and loaded.profile.last_seed==12345 and loaded.profile.difficulty==5,"wins seed difficulty preserved")
	check(loaded.profile.reduced_motion and loaded.profile.faction=="houses","accessibility and power preserved")
	check(FileAccess.get_file_as_bytes(store.path)==bytes,"loading never silently rewrites old file")
	check(store.save_profile(loaded.profile),"explicit migrated save succeeds")
	check(FileAccess.get_file_as_bytes(store.path+".bak")==bytes,"migration save keeps byte-identical last valid old profile backup")
	var reread: Dictionary=store.load_profile()
	check(not reread.get("migrated",true),"v2 reload does not report a second migration")
	same(reread.profile,loaded.profile,"v2 data survives actual disk reload")
	var decoded=JSON.parse_string(JSON.stringify(original))
	write_json(store.path,decoded)
	check(store.load_profile().profile.wins==17,"integral numbers decoded from JSON floats remain valid")

func test_quarantine() -> void:
	var store=case_store("quarantine")
	var p=v1_profile()
	var unknown=old_catalog.deck("houses");unknown[0]="removed-card-id"
	var too_many=old_catalog.deck("houses");too_many[3]=too_many[0]
	var mixed=old_catalog.deck("houses");mixed[0]="oa-ninth-c01"
	p.decks["removed"]={"mode":"alpha","cards":unknown}
	p.decks["copies"]={"mode":"alpha","cards":too_many}
	p.decks["mixed"]={"mode":"alpha","cards":mixed}
	p.decks["short"]={"mode":"alpha","cards":old_catalog.deck("houses").slice(0,29)}
	p.decks["bad-shape"]={"mode":"alpha","cards":"not-an-array"}
	p.decks["bad-mode"]={"mode":"invented","cards":old_catalog.deck("houses")}
	p.quarantined_decks={"earlier":{"original":{"cards":["previously-removed"]},"reason":"historical"}}
	write_json(store.path,p)
	var loaded: Dictionary=store.load_profile()
	check(loaded.profile.decks.size()==1,"only independently valid deck stays active")
	check(loaded.profile.quarantined_decks.size()==7,"six invalid decks plus earlier quarantine retained")
	for key in ["removed","copies","mixed","short","bad-shape","bad-mode"]:
		check(loaded.profile.quarantined_decks.has(key),"invalid deck quarantined "+key)
		if not loaded.profile.quarantined_decks.has(key): continue
		same(loaded.profile.quarantined_decks[key].original,p.decks[key],"original recoverable without ID rewrite "+key)
		check(not loaded.profile.quarantined_decks[key].reason.is_empty(),"repair reason "+key)
	same(loaded.profile.quarantined_decks.get("earlier"),p.quarantined_decks.earlier,"earlier quarantine preserved")
	check(store.save_profile(loaded.profile),"quarantined profile can persist safely")
	same(store.load_profile().profile.quarantined_decks,loaded.profile.quarantined_decks,"quarantine roundtrips exactly")
	var future=valid_profile()
	future.decks["alpha:houses"].catalog_profile="production-unknown-future"
	write_json(store.path,future)
	var blocked: Dictionary=store.load_profile()
	check(not blocked.profile.decks.has("alpha:houses"),"unknown future deck profile not silently reinterpreted")
	check(blocked.profile.quarantined_decks.has("alpha:houses"),"unknown future deck profile remains recoverable")
	store=case_store("malformed-quarantine-recovery")
	var damaged=valid_profile()
	damaged.quarantined_decks=["old-card-id",{"raw":"still recoverable"}]
	write_json(store.path,damaged)
	var repaired: Dictionary=store.load_profile()
	check(repaired.profile.quarantined_decks.size()==1,"malformed historical quarantine retained as one recovery entry")
	var retained := false
	for entry in repaired.profile.quarantined_decks.values():
		if entry is Dictionary and entry.get("original")==damaged.quarantined_decks: retained=true
	check(retained,"malformed historical quarantine payload not discarded")
	check(store.save_profile(repaired.profile),"recovered quarantine shape can be saved")
	same(store.load_profile().profile.quarantined_decks,repaired.profile.quarantined_decks,"recovered malformed quarantine survives disk reload")

func test_corruption_and_backup() -> void:
	var store=case_store("backup")
	var first=valid_profile();first.wins=1
	var second=valid_profile();second.wins=2
	check(store.save_profile(first),"initial real save")
	check(store.save_profile(second),"second real save")
	if not read_json(store.path) is Dictionary or not read_json(store.path+".bak") is Dictionary: return
	check(read_json(store.path).wins==2 and read_json(store.path+".bak").wins==1,"last good backup points at previous valid file")
	var raw="{corrupt original profile\nwith recoverable bytes"
	write_raw(store.path,raw)
	var recovered: Dictionary=store.load_profile()
	check(recovered.recovered,"corrupt main recovers last good backup")
	check(recovered.profile.wins==1 and not recovered.issues.is_empty(),"backup contents and recovery notice exposed")
	check(FileAccess.get_file_as_string(store.path)==raw,"recovery does not destroy corrupt source before explicit save")
	recovered.profile.wins=3
	check(store.save_profile(recovered.profile),"save after recovery succeeds")
	check(FileAccess.get_file_as_string(store.path+".corrupt")==raw,"raw corrupt source preserved byte for byte")
	check(read_json(store.path+".bak").wins==1,"corrupt main never overwrites valid backup")
	check(store.load_profile().profile.wins==3,"repaired file loads normally")
	write_raw(store.path,"not json")
	write_raw(store.path+".bak","also not json")
	var fallback: Dictionary=store.load_profile()
	check(not fallback.recovered,"two corrupt files do not claim valid backup")
	check(fallback.profile.wins==0 and not fallback.issues.is_empty(),"two corrupt files report defaults plus issues")
	check(FileAccess.get_file_as_string(store.path)=="not json" and FileAccess.get_file_as_string(store.path+".bak")=="also not json","loading both corrupt files preserves both original byte streams")

func test_filesystem_failures() -> void:
	var store=case_store("tmp-failure")
	var initial=valid_profile()
	check(store.save_profile(initial),"tmp failure initial save")
	var bytes=FileAccess.get_file_as_bytes(store.path)
	check(DirAccess.make_dir_absolute(ProjectSettings.globalize_path(store.path+".tmp"))==OK,"make real unwritable tmp destination directory")
	var next=valid_profile();next.wins=99
	check(not store.save_profile(next),"tmp open failure is returned")
	check(FileAccess.get_file_as_bytes(store.path)==bytes,"tmp failure leaves previous profile bytes unchanged")
	store=case_store("backup-failure")
	check(store.save_profile(initial),"backup failure initial save")
	bytes=FileAccess.get_file_as_bytes(store.path)
	check(DirAccess.make_dir_absolute(ProjectSettings.globalize_path(store.path+".bak"))==OK,"make real backup destination directory")
	check(not store.save_profile(next),"backup copy failure is returned")
	check(FileAccess.get_file_as_bytes(store.path)==bytes,"backup failure leaves previous profile bytes unchanged")
	store=case_store("rename-failure")
	check(DirAccess.make_dir_absolute(ProjectSettings.globalize_path(store.path))==OK,"make occupied final destination directory")
	write_raw(store.path.path_join("sentinel"),"preserved")
	check(not store.save_profile(next),"final rename collision is returned")
	check(FileAccess.get_file_as_string(store.path.path_join("sentinel"))=="preserved","failed rename does not remove occupied target")
	# Session must roll back its in-memory deck when the real filesystem fails.
	var s=Session.new()
	s.production_catalog=old_catalog
	s.store=case_store("session-save-rollback")
	s.profile=valid_profile()
	check(s.store.save_profile(s.profile),"session rollback initial disk save")
	var before=s.profile.duplicate(true)
	check(DirAccess.make_dir_absolute(ProjectSettings.globalize_path(s.store.path+".tmp"))==OK,"block session tmp destination")
	var reply: Dictionary=s.save_deck("alpha:houses",old_catalog.deck("houses"),"alpha")
	check(not reply.ok,"session reports failed deck save")
	same(s.profile,before,"failed deck save rolls back in-memory profile")

func test_input_types() -> void:
	var invalid_roots: Array=[null,[],"text",42,true,{"version":99,"decks":{}},{"version":2.5,"decks":{}},{"version":"2","decks":{}},{"version":true,"decks":{}},{"version":2,"decks":[]}]
	for i in invalid_roots.size():
		var store=case_store("invalid-root-"+str(i))
		write_json(store.path,invalid_roots[i])
		var result: Dictionary=store.load_profile()
		check(not result.recovered and result.profile.decks.is_empty(),"bad root falls back without active decks "+str(i))
		check(not result.issues.is_empty(),"bad root receives notice "+str(i))
	for value in [1.5,"17",true,null]:
		var store=case_store("invalid-scalar-"+str(typeof(value)))
		var p=v1_profile();p.wins=value;p.last_seed=value;p.difficulty=value
		write_json(store.path,p)
		var loaded: Dictionary=store.load_profile()
		check(loaded.profile.wins==0,"invalid wins ignored "+str(value))
		check(loaded.profile.last_seed==Store.defaults().last_seed,"invalid seed ignored "+str(value))
		check(loaded.profile.difficulty==2,"invalid difficulty ignored "+str(value))
	var store=case_store("invalid-save")
	var p=valid_profile()
	check(store.save_profile(p),"invalid-save baseline")
	var bytes=FileAccess.get_file_as_bytes(store.path)
	for key in ["wins","last_seed","difficulty"]:
		for value in [NAN,INF,-INF,1.5,"17",true]:
			var invalid=p.duplicate(true);invalid[key]=value
			check(not store.save_profile(invalid),"non-finite/nonintegral/wrongtype rejected before save "+key+":"+str(value))
			check(FileAccess.get_file_as_bytes(store.path)==bytes,"invalid scalar does not overwrite existing file "+key+":"+str(value))
	var invalid=p.duplicate(true);invalid.quarantined_decks={"nested":{"original":{"unsafe":[INF]}}}
	check(not store.save_profile(invalid),"nested nonfinite value cannot silently stringify to null")
	invalid=p.duplicate(true);invalid.quarantined_decks={3:{"original":"numeric-key"}}
	check(not store.save_profile(invalid),"non-string dictionary keys rejected before JSON coercion")
	invalid=p.duplicate(true);invalid.decks["alpha:houses"].cards[0]="not-a-real-card"
	check(not store.save_profile(invalid),"invalid active deck not persisted as usable")
	invalid=p.duplicate(true);invalid.decks["alpha:houses"].catalog_profile="unknown-future-catalog"
	check(not store.save_profile(invalid),"unknown active deck profile cannot be persisted as current catalog")
	invalid=p.duplicate(true);invalid.quarantined_decks=[]
	check(not store.save_profile(invalid),"quarantine must retain dictionary shape on save")
	invalid=p.duplicate(true);invalid.version=3
	check(not store.save_profile(invalid),"unknown profile save version rejected")
	check(FileAccess.get_file_as_bytes(store.path)==bytes,"all bad saves preserve original profile")
	store=case_store("future-readonly")
	var future=valid_profile();future.version=99
	write_json(store.path,future)
	bytes=FileAccess.get_file_as_bytes(store.path)
	var future_read: Dictionary=store.load_profile()
	check(not future_read.issues.is_empty(),"unknown future version reported")
	check(not store.save_profile(valid_profile()),"unknown future version cannot be overwritten by defaults")
	check(FileAccess.get_file_as_bytes(store.path)==bytes,"unknown future raw file preserved")
	store=case_store("oversized")
	write_raw(store.path,"x".repeat(Store.MAX_BYTES+1))
	var loaded: Dictionary=store.load_profile()
	check(loaded.profile.decks.is_empty() and not loaded.issues.is_empty(),"oversized main rejected with recovery notice")

func old_fixture() -> Dictionary:
	return JSON.parse_string(FileAccess.get_file_as_string("res://tests/fixtures/production/alpha_v1_replay.json"))

func test_archived_replay() -> void:
	var old=old_fixture()
	check(old.version==1 and old.commands.size()==5,"actual live-fde v1 fixture has five commands")
	check(old.final=="5e4cd2a9fa077b8f6cefa44a9800d2faba803206d559bcfd6e51926f1b212667","immutable original final digest")
	var result: Dictionary=Session.replay(old)
	check(result.ok,"real archived version1 replay accepted")
	check(Session.digest(result.get("state",{}))==old.final,"real archived replay finalstate preserved")
	if not result.ok: return
	var s=Session.new()
	check(s.start_match("alpha",old.setup.deck,int(old.setup.seed),int(old.setup.difficulty),old.setup.enemy_deck,true,Session.ARCHIVE_PROFILE),"explicit archived session start")
	var zero=Session.replay_prefix(old,0)
	check(zero.ok and zero.steps==0,"zero-step replay prefix valid")
	same(zero.state,s.model.snapshot(),"zero-step prefix equals actual initial model")
	for i in old.commands.size():
		check(s.command(old.commands[i].name,old.commands[i].args).ok,"v1 original command through new Session "+str(i))
		var prefix=Session.replay_prefix(old,i+1)
		check(prefix.ok and prefix.steps==i+1,"valid prefix step "+str(i+1))
		same(prefix.state,s.model.snapshot(),"prefix exactly matches command state "+str(i+1))
	var v2=s.audit()
	check(v2.version==2 and v2.setup.rules_profile==Session.ARCHIVE_PROFILE,"archived play writes explicit v2 rules profile")
	var roundtrip=Session.replay(JSON.parse_string(JSON.stringify(v2)))
	check(roundtrip.ok,"v2 archived session replay roundtrips")
	same(roundtrip.events,s.model.events,"v2 checks complete original event order")
	for field in ["before","after","event_sha256","first_event","last_event"]:
		var bad=v2.duplicate(true)
		bad.commands[1][field]=999 if field in ["first_event","last_event"] else "tampered"
		check(not Session.replay(bad).ok,"v2 rejects command tamper "+field)
	for field in ["accepted","result_ok"]:
		var altered=v2.duplicate(true);altered.commands[1][field]=false
		check(not Session.replay(altered).ok,"v2 rejects command outcome tamper "+field)
	for field in ["name","args","before","after","event_sha256","first_event","last_event","accepted","result_ok"]:
		var wrong_type=v2.duplicate(true)
		wrong_type.commands[1][field]="wrong-type" if field in ["first_event","last_event","accepted","result_ok","args"] else 17
		check(not Session.replay(wrong_type).ok,"malformed command field gracefully rejected "+field)
	for field in ["format","final","event_sha256","winner"]:
		var wrong_type=v2.duplicate(true);wrong_type[field]=17
		check(not Session.replay(wrong_type).ok,"malformed replay metadata gracefully rejected "+field)
	for field in ["mode","rules_profile","catalog_sha256"]:
		var wrong_type=v2.duplicate(true);wrong_type.setup[field]=17
		check(not Session.replay(wrong_type).ok,"malformed replay setup gracefully rejected "+field)
	var bad=v2.duplicate(true);bad.event_sha256="tampered"
	check(not Session.replay(bad).ok,"v2 rejects complete event digest tamper")
	bad=v2.duplicate(true);bad.winner="hero"
	check(not Session.replay(bad).ok,"v2 rejects fabricated declared winner")
	bad=v2.duplicate(true);bad.commands.reverse()
	check(not Session.replay(bad).ok,"v2 rejects reordered commands")
	for step in [-2,v2.commands.size()+1]: check(not Session.replay_prefix(v2,step).ok,"invalid replay step rejected "+str(step))
	for version in [3,2.5,"2",true]:
		bad=v2.duplicate(true);bad.version=version
		check(not Session.replay(bad).ok,"unknown invalid replay version "+str(version))
	for key in ["seed","difficulty"]:
		for value in [NAN,INF,-INF,1.5,"5",true]:
			bad=v2.duplicate(true);bad.setup[key]=value
			check(not Session.replay(bad).ok,"malformed replay numeric input "+key+":"+str(value))
	var before=s.model.snapshot();var setup=s.setup.duplicate(true);var commands=s.commands.duplicate(true);var mode=s.mode
	check(not s.start_match("legacy",[],42),"invalid new start rejected")
	check(s.mode==mode,"invalid start cannot change active mode")
	same(s.setup,setup,"invalid start preserves setup")
	same(s.commands,commands,"invalid start preserves command history")
	same(s.model.snapshot(),before,"invalid start preserves battle model")

func test_event_transport_numbers() -> void:
	var integer_events=[{"kind":"summon","lane":0,"amount":2},{"kind":"hit","lane":1,"amount":1.5}]
	var decoded=JSON.parse_string(JSON.stringify(integer_events))
	check(Session.event_digest(integer_events)==Session.event_digest(decoded),"JSON 0 and parsed 0.0 represent same ordered event")
	var floats=[{"kind":"summon","lane":0.0,"amount":2.0},{"kind":"hit","lane":1.0,"amount":1.5}]
	check(Session.event_digest(integer_events)==Session.event_digest(floats),"integer-valued event transport does not change digest")
	var reordered=integer_events.duplicate(true);reordered.reverse()
	check(Session.event_digest(integer_events)!=Session.event_digest(reordered),"event canonicalization still detects reordered events")
	var changed=integer_events.duplicate(true);changed[1].amount=1.6
	check(Session.event_digest(integer_events)!=Session.event_digest(changed),"event canonicalization preserves genuinely fractional value differences")
	changed=integer_events.duplicate(true);changed[0].lane=1
	check(Session.event_digest(integer_events)!=Session.event_digest(changed),"event canonicalization detects changed integral values")

func mechanical_digest(card: Dictionary) -> String:
	return JSON.stringify(_production_type().mechanical_card(card),"",true).sha256_text()

func test_mechanical_fingerprint() -> void:
	# Read an independent local data copy. Never mutate the live catalog cache or
	# a model binding to simulate a cosmetic change.
	var data: Dictionary=JSON.parse_string(FileAccess.get_file_as_string(_production_type().SOURCE_PATH))
	var original: Dictionary={}
	for candidate in data.cards:
		if candidate.get("rarity")=="legendary" and candidate.get("species",[]).size()==2 and candidate.get("abilities",[]).size()>1:
			original=candidate.duplicate(true);break
	check(not original.is_empty(),"actual production catalog supplies a dual-species multi-ability legendary fingerprint case")
	if original.is_empty(): return
	var baseline=mechanical_digest(original)
	var before=original.duplicate(true)
	for key in ["name","description","art","status","lore_status","lore","flavor"]:
		var cosmetic=original.duplicate(true)
		cosmetic[key]={"asset_id":"another-illustration","status":"concept"} if key=="art" else "Editorial-only change"
		check(mechanical_digest(cosmetic)==baseline,"cosmetic field does not invalidate mechanical replay fingerprint "+key)
	var reordered_species=original.duplicate(true)
	reordered_species.species.reverse()
	check(mechanical_digest(reordered_species)==baseline,"equal-rank species order does not invalidate mechanical replay fingerprint")
	for key in ["cost","atk","hp"]:
		var changed=original.duplicate(true);changed[key]=int(changed[key])+1
		check(mechanical_digest(changed)!=baseline,"real numerical card rule changes fingerprint "+key)
	for pair in [["faction","houses"],["order","ninth"],["rarity","common"]]:
		var changed=original.duplicate(true);changed[pair[0]]=pair[1]
		check(mechanical_digest(changed)!=baseline,"real power/order/copy-limit change changes fingerprint "+pair[0])
	var reordered_abilities=original.duplicate(true)
	reordered_abilities.abilities.reverse()
	check(mechanical_digest(reordered_abilities)!=baseline,"ability resolution order remains part of mechanical replay fingerprint")
	var changed_ability=original.duplicate(true)
	changed_ability.abilities[0].target="own_all" if original.abilities[0].target!="own_all" else "self"
	check(mechanical_digest(changed_ability)!=baseline,"ability target change changes mechanical replay fingerprint")
	var changed_species=original.duplicate(true)
	changed_species.species=["human"]
	check(mechanical_digest(changed_species)!=baseline,"actual species membership change remains mechanical")
	same(original,before,"mechanical fingerprint helper never mutates caller-owned card data")
	var detached=_production_type().mechanical_card(original)
	detached.abilities.clear()
	detached.species.reverse()
	same(original,before,"mechanical fingerprint view owns independent nested arrays")

func test_accepted_terminal_failure() -> void:
	var s=Session.new()
	var m=InjectedTerminalFailure.new()
	check(m.start_alpha(old_catalog.deck("houses"),old_catalog.deck("morph"),12345,5),"technical-failure injection starts real archived model")
	s.model=m
	var before=Session.digest(m.snapshot())
	var offset: int=m.events.size()
	var reply: Dictionary=s.command("test_only_injected_failure",[])
	check(not reply.ok and reply.get("accepted",false),"accepted terminal failure remains distinct from illegal action")
	check(s.commands.size()==1,"accepted terminal failure recorded exactly once")
	if s.commands.size()==1:
		var record: Dictionary=s.commands[0]
		check(record.before==before and record.after==Session.digest(m.snapshot()),"accepted failure records actual before/after state")
		check(record.first_event==offset and record.last_event==m.events.size()-1,"accepted failure records event boundaries")
		check(record.event_sha256==Session.event_digest(m.events.slice(offset)),"accepted failure records exact error-event digest")
		check(record.get("accepted",false),"accepted failure flag survives in command record")

func complete_session(power: String, seed_value: int):
	var s=Session.new()
	var c=s.active_catalog()
	check(s.start_match("alpha",c.deck(power),seed_value,5,c.deck("morph")),"production Session start "+power)
	check(s.command("mulligan",[[]]).ok,"production mulligan "+power)
	check(s.command("origin",[2]).ok,"production origin "+power)
	if s.model.state.stage=="second": check(s.command("openingDone",[]).ok,"production second possibility skip "+power)
	var turn:=0
	while s.model.state.winner==null and s.model.state.error.is_empty() and turn<400:
		var m=s.model;var p: Dictionary=m.state.hero
		if p.phase=="draw":
			while p.hand.size()+mini(int(p.pendingDraw),p.deck.size())>6:
				check(s.command("burn",["hero",0]).ok,"production forced burn")
			check(s.command("finishDraw",["hero"]).ok,"production finish draw")
		for _action in 20:
			if m.state.winner!=null or not m.state.error.is_empty(): break
			if p.pendingTarget!=null:
				for lane in 5:
					if m.state.enemy.lanes[lane]!=null:
						check(s.command("chooseStrikeTarget",["hero",lane]).ok,"production target")
						break
				continue
			if p.pendingShift!=null:
				check(s.command("skipShift",["hero"]).ok,"production pending shift skip")
				continue
			var choice: Dictionary={}
			for index in p.hand.size():
				for lane in 5:
					if m.play_support("hero",index,lane).is_empty():
						choice={"index":index,"lane":lane};break
				if not choice.is_empty(): break
			if choice.is_empty(): break
			check(s.command("play",["hero",choice.index,choice.lane]).ok,"production legal card play")
		if m.state.winner==null and m.state.error.is_empty(): check(s.command("endTurn",["hero"]).ok,"production complete endTurn")
		turn+=1
	check(s.model.state.error.is_empty(),"production full session no effect error "+power)
	check(s.model.state.winner!=null,"production full session terminates "+power)
	var audit=s.audit()
	check(audit.version==2 and audit.setup.rules_profile==Session.PRODUCTION_PROFILE,"production replay binds actual rules profile")
	check(audit.setup.catalog_sha256==c.fingerprint(),"production replay binds actual catalog fingerprint")
	var replay: Dictionary=Session.replay(JSON.parse_string(JSON.stringify(audit)))
	if not replay.ok:
		print("PRODUCTION REPLAY FAILURE ",power," ",JSON.stringify(replay))
		write_json("res://work/production-storage/failed-"+power+"-audit.json",audit)
		write_json("res://work/production-storage/failed-"+power+"-original-state.json",s.model.snapshot())
		write_json("res://work/production-storage/failed-"+power+"-original-events.json",s.model.events)
	check(replay.ok,"production full Session replay verified "+power)
	same(replay.get("state",{}),s.model.snapshot(),"production replay full state "+power)
	# JSON transport represents integral values such as lane 0 as 0.0 in Godot.
	# Compare every ordered field after the same transport normalization, while
	# separate tests above reject changed values and reordered events.
	same(JSON.parse_string(JSON.stringify(replay.get("events",[]))),JSON.parse_string(JSON.stringify(s.model.events)),"production replay full ordered JSON event payload "+power)
	var corrupt=audit.duplicate(true);corrupt.setup.catalog_sha256="wrong-catalog"
	check(not Session.replay(corrupt).ok,"production catalog mismatch rejected")
	production_games+=1
	return s

func run() -> void:
	check(DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(ROOT))==OK,"storage test root")
	if OS.has_feature("linux") and not OS.get_environment("XDG_DATA_HOME").is_empty():
		check(OS.get_user_data_dir()==OS.get_environment("XDG_DATA_HOME").path_join("godot/app_userdata/NACHTSIEGEL"),"ORAFOLD rename preserves original Linux native user directory")
	test_v1_migration()
	test_storage_namespace_isolation()
	test_import_backup_and_versions()
	test_authoritative_web_backend()
	test_quarantine()
	test_corruption_and_backup()
	test_filesystem_failures()
	test_input_types()
	test_archived_replay()
	test_event_transport_numbers()
	test_mechanical_fingerprint()
	test_accepted_terminal_failure()
	if OS.get_cmdline_user_args().has("--focused"):
		production_deferred=true
		print("PRODUCTION STORAGE: production session suite explicitly deferred; focused storage/archive run only")
	else:
		check(FileAccess.file_exists("res://data/production/cards.json") and FileAccess.file_exists("res://scripts/card_system/production_model.gd"),"production catalog and engine must actually exist")
		if FileAccess.file_exists("res://data/production/cards.json") and FileAccess.file_exists("res://scripts/card_system/production_model.gd"):
			for power in ["houses","stillwatch","morph","ninth"]: complete_session(power,12345)
	old_catalog=null
	print(JSON.stringify({"suite":"production_storage","assertions":assertions,"failures":failures,"production_games":production_games,"production_deferred":production_deferred,"archive_fixture_source":"fde508e85a2866e24653ef25d920a59832d2d653"}))
	root.get_node("GameAudio").request_quit(0 if failures==0 else 1)
