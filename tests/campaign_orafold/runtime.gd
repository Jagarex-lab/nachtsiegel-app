extends SceneTree
const Manager = preload("res://scripts/campaign_orafold/campaign_manager.gd")
const State = preload("res://scripts/campaign_orafold/campaign_state.gd")
const Dialogue = preload("res://scripts/campaign_orafold/dialogue_manager.gd")
var assertions := 0
var failures := 0
var temporary_paths: Array = []
func check(ok: bool, message: String) -> void:
	assertions += 1
	if not ok:
		failures += 1
		printerr("FAIL: ", message)
func path_for(label: String) -> String:
	var path := "user://campaign_test_" + label + ".json"
	for suffix in ["", ".bak", ".tmp"]:
		if FileAccess.file_exists(path + suffix): DirAccess.remove_absolute(path + suffix)
	temporary_paths.append(path)
	return path
func write_json(path: String, value: Variant) -> void:
	var f := FileAccess.open(path, FileAccess.WRITE)
	f.store_string(JSON.stringify(value)); f.close()
func stable(data: Dictionary) -> String: return JSON.stringify(data, "", true)
func unchanged(manager, action: Callable, message: String) -> void:
	var before := stable(manager.state.data)
	check(not action.call(), message + " rejected")
	check(stable(manager.state.data) == before, message + " leaves durable state unchanged")
func _initialize() -> void:
	_save_tests()
	for approach in ["preserve", "compare"]:
		for ending in ["record", "open"]:
			_flow(approach, ending)
	_knowledge_tests()
	_reward_tests()
	_failure_tests()
	for path in temporary_paths:
		for suffix in ["", ".bak", ".tmp"]:
			if FileAccess.file_exists(path + suffix): DirAccess.remove_absolute(path + suffix)
	print("ORAFOLD RUNTIME: %d assertions, %d failures; decision matrix, durable battle routes, migration, replay and rewards" % [assertions, failures])
	quit(1 if failures else 0)
func _flow(approach: String, ending: String) -> void:
	var path := path_for(approach + "_" + ending)
	var m = Manager.new("res://data/campaign_orafold/prototype.json", path)
	check(m.validation.ok, "Bundle validates before manager use")
	check(m.load_campaign(), "Campaign loads")
	check(m.chapters().size() == 2, "Two data-driven chapters")
	check(m.chapters()[0].unlocked and not m.chapters()[1].unlocked, "Prerequisite protects second chapter")
	unchanged(m, func(): return m.start_chapter("cp02"), "Locked chapter")
	unchanged(m, func(): return m.start_chapter("missing"), "Missing chapter")
	check(m.character("eira").knowledge.is_empty(), "Eira knowledge starts sealed")
	check(m.character("eira").protected, "Eira metadata protected")
	check(m.character("missing").is_empty(), "Unknown character safe")
	check(m.start_chapter("cp01"), "Chapter starts")
	check(m.current_scene().id == "threshold", "Data-defined chapter entry")
	check(not m.state.data.seen_scenes.has("threshold"), "Opening not marked read before advancing")
	check(m.advance(), "Scene advances")
	check(m.state.data.seen_scenes.has("threshold"), "Read scene recorded")
	check(m.dialogue.history().size() == 3, "Read dialogue history captured")
	check(m.available_choices().size() == 2, "Choice alternatives exposed")
	unchanged(m, func(): return m.advance(), "Decision requires explicit choice")
	unchanged(m, func(): return m.choose("typo"), "Unknown choice")
	check(m.choose(approach), "Branch choice accepted")
	check(m.state.data.flags.approach == approach, "Consequence flag")
	check(m.state.data.decisions.approach == approach, "Single recorded decision")
	check(m.state.data.relationships.sena == 1, "Relationship consequence exactly once")
	check(m.current_scene().id == approach, "Choice-specific scene")
	unchanged(m, func(): return m.choose("compare" if approach == "preserve" else "preserve"), "Opposite choice cannot be appended")
	check(m.advance(), "Branch converges into encounter")
	check(m.current_scene().id == "practice", "Shared scene limits branching")
	unchanged(m, func(): return m.advance(), "Encounter blocks narrative advance")
	var request: Dictionary = m.request_battle()
	check(not request.is_empty() and request.has("token"), "Adapter request emitted")
	check(request.deck_profile == "houses" and request.enemy_profile == "stillwatch", "Deck profiles configured, no final card IDs")
	check(m.request_battle().token == request.token, "Duplicate battle start returns same token")
	unchanged(m, func(): return m.resolve_battle("fake", "victory"), "Stale battle result")
	unchanged(m, func(): return m.resolve_battle(request.token, "draw"), "Unsupported battle outcome")
	m = Manager.new("res://data/campaign_orafold/prototype.json", path)
	check(m.load_campaign(), "Campaign reload while battle active")
	check(m.request_battle().token == request.token, "Safe checkpoint restores battle token")
	check(m.state.data.flags.approach == approach, "Decision survives reload")
	check(m.resolve_battle(request.token, "defeat"), "Defeat callback accepted")
	check(m.current_scene().id == "defeat", "Defeat narrative route")
	check(m.state.data.encounters.first_practice.defeats == 1, "Defeat counter once")
	unchanged(m, func(): return m.resolve_battle(request.token, "defeat"), "Duplicate defeat callback")
	check(not m.state.data.completed_chapters.has("cp01"), "Defeat grants no completion")
	check(m.advance(), "Defeat returns to retry")
	var retry: Dictionary = m.request_battle()
	check(retry.token != request.token, "Retry has fresh durable token")
	check(m.resolve_battle(retry.token, "victory"), "Victory callback accepted")
	check(m.current_scene().id == "victory", "Victory narrative route")
	unchanged(m, func(): return m.resolve_battle(retry.token, "victory"), "Duplicate victory callback")
	check(m.advance(), "Victory chapter completes")
	check(m.current_scene().is_empty(), "Completion returns to overview")
	check(m.state.data.completed_chapters.has("cp01"), "Completion durable")
	check(m.chapters()[1].unlocked, "Next chapter unlocked")
	check(m.state.data.character_info.has("sena_player_note"), "Modular character info reward")
	check(m.state.data.reward_ledger.sena_note.state == "delivered", "Internal reward recorded")
	var baseline: Dictionary = {}
	for key in ["flags", "decisions", "relationships", "character_info", "unlocked_chapters", "reward_ledger", "history"]: baseline[key] = m.state.data[key].duplicate(true)
	check(m.replay_chapter("cp01"), "Completed chapter replay starts")
	check(m.advance(), "Replay scene advances")
	var opposite := "compare" if approach == "preserve" else "preserve"
	check(m.choose(opposite), "Replay explores alternative")
	check(m.state.data.flags.approach == opposite, "Replay consequences visible within replay")
	check(m.advance(), "Replay encounter entry")
	var replay_request: Dictionary = m.request_battle()
	check(m.resolve_battle(replay_request.token, "victory"), "Replay battle returns")
	check(m.advance(), "Replay completes")
	for key in baseline: check(stable({"value":m.state.data[key]}) == stable({"value":baseline[key]}), "Replay preserves campaign baseline " + str(key))
	check(m.state.data.completed_chapters.count("cp01") == 1, "No duplicate chapter completion")
	check(m.start_chapter("cp02"), "Unlocked chapter starts")
	var lines: Array = m.dialogue.lines(m.current_scene(), m.state.data)
	check(lines.size() == 2, "Conditional dialogue has one branch and narrator")
	check(lines[0].text_id == ("dialogue.return.01" if approach == "preserve" else "dialogue.return.02"), "Prior decision changes perspective")
	check(m.advance(), "Return scene advances")
	check(m.advance(), "Faction scene advances")
	check(m.current_scene().id == "blank", "Protected character placeholder scene")
	check(m.character("eira").knowledge.is_empty(), "Eira stays sealed until scene completed")
	check(m.advance(), "Protected information unlock trigger")
	check(m.character("eira").knowledge.size() == 1, "Only authored open question becomes player knowledge")
	check(m.character("eira").knowledge[0].status == "OFFEN", "Open Eira content stays open")
	check(m.choose(ending), "Final local decision")
	check(m.advance(), "Alternative ending completes")
	check(m.state.data.completed_chapters.size() == 2, "Both chapters complete")
	check(m.state.data.flags.get("ending", "") == ("documented" if ending == "record" else "unwritten"), "Distinct local ending state")
	check(m.state.data.reward_ledger.size() == 4, "Two local lore rewards and two pending production chapter rewards")
	for chapter in [1,2]:
		var grant: Dictionary = m.state.data.reward_ledger["production_chapter_"+str(chapter)]
		check(grant.state == "pending" and grant.payload.get("reward_id") == "campaign_chapter" and int(grant.payload.get("chapter",0)) == chapter, "Configured economy reward awaits durable receipt")
	m = Manager.new("res://data/campaign_orafold/prototype.json", path)
	check(m.load_campaign(), "Completed campaign reloads")
	check(m.state.data.completed_chapters.size() == 2, "Completion survives reload")
	check(m.set_setting("locale", "en"), "Locale setting persisted")
	check(m.dialogue.text("chapter.cp01.title") == m.dialogue.text("chapter.cp01.title", "en"), "Runtime language switch")
	unchanged(m, func(): return m.set_setting("text_scale", 9.0), "Invalid text scale")
	check(m.dialogue.text("chapter.cp01.title", "en-GB") == m.dialogue.text("chapter.cp01.title", "en"), "Regional language normalized")
	check(m.dialogue.text("chapter.cp01.title", "fr") == m.dialogue.text("chapter.cp01.title", "de"), "Unsupported language falls back visibly in diagnostics")
	check(m.dialogue.missing_translations.has("fr:chapter.cp01.title"), "Missing locale reported")
	check(m.dialogue.text("missing.key") == "[missing:missing.key]", "Missing translation sentinel")
func _save_tests() -> void:
	var path := path_for("storage")
	var s = State.new(path)
	check(State.valid(s.data), "Fresh isolated save schema valid")
	s.data.flags["test"] = "first"
	check(s.save(), "Initial atomic save")
	s.data.flags["test"] = "second"
	check(s.save(), "Second save rotates backup")
	check(FileAccess.file_exists(path + ".bak"), "Last good backup exists")
	var f := FileAccess.open(path, FileAccess.WRITE); f.store_string("{broken"); f.close()
	var recovered = State.new(path)
	check(recovered.recovered, "Corrupted primary recovers backup")
	check(recovered.data.flags.test == "first", "Recovery returns last known good state")
	check(recovered.save(), "Recovery can save without clobbering good backup")
	check(JSON.parse_string(FileAccess.get_file_as_string(path + ".bak")).flags.test == "first", "Bad primary never rotates over valid backup")
	var old: Dictionary = State.defaults(); old.schema_version = 1; old["visited_scenes"] = ["threshold"]; old.erase("seen_scenes"); old.erase("revision")
	write_json(path, old)
	var migrated = State.new(path)
	check(migrated.data.schema_version == 2 and migrated.data.seen_scenes == ["threshold"], "Explicit v1 visited-scenes migration")
	check(not migrated.data.has("visited_scenes"), "Old field removed from migrated representation")
	var future: Dictionary = State.defaults(); future.schema_version = 999
	write_json(path, future)
	var original := FileAccess.get_file_as_string(path)
	var blocked = State.new(path)
	check(blocked.read_only and blocked.last_error == "save.future_version", "Future save protected")
	check(not blocked.save(), "Future save cannot be downgraded")
	check(FileAccess.get_file_as_string(path) == original, "Unknown version bytes untouched")
	check(State.migrate({"schema_version":1,"format":"ARVESS"}) == null, "Other save namespace not migrated")
	check(State.migrate([]) == null, "Non dictionary migration rejected")
	for key in ["unlocked_chapters", "completed_chapters", "seen_scenes", "character_info"]:
		var bad: Dictionary = State.defaults(); bad[key] = [42]; check(not State.valid(bad), "Save rejects malformed ID list " + key)
	for key in ["decisions", "flags", "relationships", "encounters", "active", "checkpoint", "reward_ledger", "settings"]:
		var bad: Dictionary = State.defaults(); bad[key] = []; check(not State.valid(bad), "Save rejects malformed dictionary " + key)
	var bad: Dictionary = State.defaults(); bad.flags.x = {}; check(not State.valid(bad), "Nested flag rejected")
	bad = State.defaults(); bad.settings.text_speed = "fast"; check(not State.valid(bad), "Invalid setting type")
	bad = State.defaults(); bad.history = [{"scene_id": 3}]; check(not State.valid(bad), "Malformed history rejected")
	bad = State.defaults(); bad.encounters.test = {"attempts":{}, "victories":0,"defeats":0}; check(not State.valid(bad), "Malformed encounter statistics rejected")
	bad = State.defaults(); bad.active = {"campaign_id":"prototype", "chapter_id":"cp01", "scene_id":"first_question", "battle":{}, "replay":false,"run_choices":[]}; check(not State.valid(bad), "Malformed active choices rejected")
	bad = State.defaults(); bad.checkpoint = {"battle":[]}; check(not State.valid(bad), "Malformed checkpoint rejected")
	bad = State.defaults(); bad.flags.x = INF; check(not State.valid(bad), "Non finite saved flags rejected")
	bad = State.defaults(); bad.encounters.test = {"attempts":-1,"victories":0,"defeats":0}; check(not State.valid(bad), "Negative encounter statistics rejected")
	var valid_cursor: Dictionary = {"campaign_id":"prototype","chapter_id":"cp01","scene_id":"practice","battle":{},"replay":false,"run_choices":{},"replay_baseline":{},"entered_scenes":["practice"],"completed_scenes":[]}
	bad = State.defaults(); bad.active = valid_cursor.duplicate(true); bad.checkpoint = valid_cursor.duplicate(true); check(State.valid(bad), "Complete v2 cursor accepted")
	bad.active.battle = {"token":"","encounter_id":"first_practice"}; check(not State.valid(bad), "Empty saved battle token rejected")
	bad = State.defaults(); bad.checkpoint = valid_cursor.duplicate(true); bad.checkpoint.battle = {"token":[],"encounter_id":"first_practice"}; check(not State.valid(bad), "Malformed checkpoint battle token rejected")
	var future_path := path_for("future_content")
	var future_content: Dictionary = State.defaults(); future_content.content_version = 999
	write_json(future_path, future_content)
	var future_bytes := FileAccess.get_file_as_string(future_path)
	var future_manager = Manager.new("res://data/campaign_orafold/prototype.json", future_path)
	check(not future_manager.load_campaign() and future_manager.last_error == "content.future_version", "Future narrative content version rejected")
	check(FileAccess.get_file_as_string(future_path) == future_bytes, "Future content progress left untouched")
	var backup_future_path := path_for("future_backup")
	write_json(backup_future_path, ["corrupt"]); write_json(backup_future_path + ".bak", future)
	var future_backup = State.new(backup_future_path)
	check(future_backup.read_only and not future_backup.save(), "Future backup protected when primary corrupt")
	var corrupt_path := path_for("both_corrupt")
	write_json(corrupt_path, ["wrong"]); write_json(corrupt_path + ".bak", {"format":"wrong"})
	var safe = State.new(corrupt_path)
	check(safe.last_error == "save.invalid_data" and State.valid(safe.data), "Two corrupt files yield safe defaults")
	check(FileAccess.get_file_as_string(corrupt_path) == '["wrong"]', "Corrupt evidence preserved")
	var corrupt_manager = Manager.new("res://data/campaign_orafold/prototype.json",corrupt_path)
	check(corrupt_manager.load_campaign() and corrupt_manager.load_notice == "save.invalid_data", "menu exposes corrupt-save recovery notice")
	check(FileAccess.get_file_as_string(corrupt_path) == '["wrong"]', "opening campaign does not overwrite corrupt evidence")
	var future_good_path := path_for("future_backup_good_primary")
	write_json(future_good_path,State.defaults()); write_json(future_good_path+".bak",future)
	var future_good = State.new(future_good_path)
	check(future_good.read_only and not future_good.save(), "future backup protected even with usable older primary")
	check(JSON.parse_string(FileAccess.get_file_as_string(future_good_path+".bak")).schema_version == 999, "future backup bytes not rotated away")
	var backup_content_path := path_for("future_content_backup_good_primary")
	write_json(backup_content_path,State.defaults()); write_json(backup_content_path+".bak",future_content)
	var backup_content = Manager.new("res://data/campaign_orafold/prototype.json",backup_content_path)
	check(not backup_content.load_campaign() and backup_content.last_error == "content.future_version", "future content backup protected with usable primary")
func _reward_tests() -> void:
	var path := path_for("external")
	var m = Manager.new("res://data/campaign_orafold/prototype.json", path)
	check(m.load_campaign(), "Reward fixture loads")
	m.content.scenes.threshold["on_enter"] = [{"type":"reward","id":"external_template"}]
	var observed: Array = []
	m.rewards.grant_requested.connect(func(id, payload, key):
		var durable: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
		observed.append({"id":id,"key":key,"durable":durable is Dictionary and durable.reward_ledger.has(id),"payload":payload})
	)
	check(m.start_chapter("cp01"), "External reward stages through scene effect")
	check(observed.size() == 1 and observed[0].durable, "Reward publication follows durable outbox write")
	var key: String = observed[0].key
	check(not m.rewards.stage("external_template", m.content.rewards.external_template, m.state.data), "Duplicate grant cannot be staged")
	unchanged(m, func(): return m.acknowledge_reward("external_template", "wrong"), "Wrong grant receipt")
	check(m.acknowledge_reward("external_template", key), "External receipt acknowledged durably")
	check(m.state.data.reward_ledger.external_template.state == "delivered", "Acknowledged reward delivered")
	unchanged(m, func(): return m.acknowledge_reward("external_template", key), "Duplicate grant receipt")
	var reopened = Manager.new("res://data/campaign_orafold/prototype.json", path)
	check(reopened.load_campaign(), "Reward ledger reload")
	check(reopened.rewards.pending(reopened.state.data).is_empty(), "Delivered grant not republished after reload")
func _failure_tests() -> void:
	var path := "user://directory-that-is-not-created/campaign.json"
	var m = Manager.new("res://data/campaign_orafold/prototype.json", path)
	var before := stable(m.state.data)
	check(not m.load_campaign(), "Unwritable destination reports failure")
	check(stable(m.state.data) == before, "Failed initial commit rolls back")
	check(not m.start_chapter("cp01"), "Failed campaign load cannot start chapter")
	check(stable(m.state.data) == before, "Failed load follow-up keeps state unchanged")
	var bad = Manager.new("res://data/campaign_orafold/not_found.json", path_for("invalid_content"))
	check(not bad.load_campaign() and bad.last_error == "content.invalid", "Missing bundle safely blocked")

func _knowledge_tests() -> void:
	var m = Manager.new("res://data/campaign_orafold/prototype.json", path_for("knowledge"))
	check(m.load_campaign(), "Knowledge fixture loads")
	m.content.characters.sena.knowledge = [
		{"id":"secret_fact","text_id":"test","category":"fact","status":"VORSCHLAG","source":"test"},
		{"id":"secret_belief","text_id":"test","category":"belief","status":"VORSCHLAG","source":"test"},
		{"id":"public_fact","text_id":"test","category":"fact","status":"VORSCHLAG","source":"test","visibility":"public"}]
	var visible: Array = m.character("sena").knowledge
	check(visible.size() == 1 and visible[0].id == "public_fact", "Private character fact and belief do not leak to player")
	m.state.data.character_info.append("secret_belief")
	visible = m.character("sena").knowledge
	check(visible.size() == 2, "Player unlock exposes only selected private belief")
	m.content.characters.eira.knowledge = [{"id":"protected_public","text_id":"test","category":"canon","visibility":"public"}]
	check(m.character("eira").knowledge.is_empty(), "Protected Eira gate overrides public visibility")
