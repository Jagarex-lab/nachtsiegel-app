{
  "name": "orafold-online-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13 <25"
  },
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "load": "node --import tsx tools/load.ts",
    "demo": "node --import tsx tools/real-duel.ts",
    "demo:duel": "node --import tsx tools/real-duel.ts",
    "demo:transport": "node --import tsx tools/demo.ts",
    "schema": "node --import tsx tools/schema.ts"
  },
  "dependencies": {
    "argon2": "0.44.0",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/ws": "8.18.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
